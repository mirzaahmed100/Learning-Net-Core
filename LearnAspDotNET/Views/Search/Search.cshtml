@using Ecommerce.Domain.Entities;
@model List<Product>


@{
    ViewData["Title"] = "Index";
}



@if (Model != null && Model.Any())
{
    <div class="container mt-4">
        <div class="row">
            @foreach (var product in Model)
            {
                <div class="col-md-4">
                    <div class="card mb-4 shadow-sm">
                        <img src="@product.ImageUrl" class="card-img-top" width="50px" height="100px" alt="Iphone Mobile" />
                        <div class="card-body">
                            <h5 class="card-title">@product.Name</h5>
                            <p class="card-text">@product.Description</p>
                            <p class="card-text"><strong>Price: </strong>@product.Price.ToString("C")</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="btn-group">
                                    <button type="button" class="btn btn-sm btn-outline-secondary">View</button>
                                  @*   <button type="button" class="btn btn-sm btn-outline-secondary">Buy</button> *@
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}
else
{
    <p>No products found.</p>
}



<a href="@Url.Action("Home", "Product")" class="btn btn-primary">Back to search</a>



